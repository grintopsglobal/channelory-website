---
// GitHub Pages hanya memakai satu 404.html; link menu memakai /id/#anchor.
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t('404.title')} | Channelory`} description={t('404.text')} alternates={{ id: '/404/' }} noindex>
  <section class="bg-slate-bg border-b border-slate-200 py-24 sm:py-32">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <span class="font-mono-num text-sm font-bold text-sky-text">404</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-navy tracking-tight">{t('404.title')}</h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{t('404.text')}</p>
      <div class="pt-2">
        <a href={localizePath(lang)} class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-cta hover:bg-cta-hover text-cta-ink text-sm font-bold transition shadow-xs">{t('404.home')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
