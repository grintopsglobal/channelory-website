      </div>

      <!-- Ponsel -->
      <div class="animate-float-android w-[178px] sm:w-[205px] bg-ink rounded-[26px] p-2 border-2 border-slate-700 shadow-2xl absolute -bottom-2 right-0 sm:right-2 z-20 select-none">
        <div class="w-0.5 h-6 bg-slate-600 rounded-r absolute -right-[3px] top-16"></div>
