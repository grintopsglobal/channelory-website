              </div>
              <div class="pt-2 border-t border-slate-800 flex items-center justify-between text-[7px] text-slate-400">
                <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Odoo Synced</span>
                <span class="font-mono-num">v2.4</span>
