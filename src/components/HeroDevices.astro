                </div>
                <div class="space-y-0.5 text-[8.5px]">
                  {
                    modules.map((m, i) => (
                      <div
                        data-nav={i}
                        data-aktif={i === 0 ? 'true' : 'false'}
                        class="group px-2 rounded flex items-center gap-1.5 data-[aktif=true]:py-1.5 data-[aktif=true]:bg-sky data-[aktif=true]:text-white data-[aktif=true]:font-bold data-[aktif=false]:py-1 data-[aktif=false]:text-slate-300 data-[aktif=false]:font-medium"
