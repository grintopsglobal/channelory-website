<script>
  const root = document.getElementById('hero-devices')!;
  const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-scene-btn]')];
  const pause = root.querySelector<HTMLButtonElement>('#scene-pause')!;
  const pauseLabel = pause.querySelector<HTMLElement>('[data-pause-label]')!;
  const ping = pause.querySelector<HTMLElement>('[data-ping]')!;
  const fades = [...root.querySelectorAll<HTMLElement>('[data-fade]')];
  const navIndex = [0, 1, 5];
  const count = btns.length;
  let active = 0;
  let timer: number | undefined;

  function show(idx: number) {
    active = idx;
    btns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === idx)));
    root.querySelectorAll<HTMLElement>('[data-nav]').forEach((el) => (el.dataset.aktif = String(Number(el.dataset.nav) === navIndex[idx])));
    fades.forEach((f) => (f.style.opacity = '0.35'));
    setTimeout(() => {
      root.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => (el.hidden = Number(el.dataset.scene) !== idx));
      fades.forEach((f) => (f.style.opacity = '1'));
    }, 150);
  }

  function setRunning(run: boolean) {
    clearInterval(timer);
    timer = run ? window.setInterval(() => show((active + 1) % count), 4500) : undefined;
    pause.setAttribute('aria-pressed', String(!run));
    pauseLabel.textContent = (run ? root.dataset.labelAktif : root.dataset.labelJeda) ?? '';
    ping.hidden = !run;
  }

  btns.forEach((b, i) =>
    b.addEventListener('click', () => {
      setRunning(false);
      show(i);
    }),
  );
  pause.addEventListener('click', () => setRunning(timer === undefined));

  // Konten yang berganti sendiri harus bisa dihentikan (WCAG 2.2.2); mati total saat reduced motion.
  setRunning(!window.matchMedia('(prefers-reduced-motion: reduce)').matches);
</script>
