---
// Panggung dua perangkat di hero. Isi layar = ilustrasi data demo (A2), tidak masuk CMS.
// Ketiga adegan dirender di HTML; JS hanya mengganti adegan yang tampil (tanpa innerHTML).
import Logo from './Logo.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  adegan: string[];
  autoPreview: string;
  autoPreviewJeda: string;
}
const { lang, adegan, autoPreview, autoPreviewJeda } = Astro.props;
const t = useTranslations(lang);

const scenes = [
  { nav: 0, breadcrumb: 'Dashboard / Ringkasan', title: 'Dashboard', sub: 'Unified partner revenue, multi-tier channel performance, and stock distribution.', partner: 'Nadia Kusuma Studio' },
  { nav: 1, breadcrumb: 'Partners / Multi-Tier Network', title: 'Partners & Hierarchy', sub: 'Nested L1–L3 agent trees, territory locks, and reseller stock allocation.', partner: 'PT Nusantara Distribusi (L1)' },
  { nav: 5, breadcrumb: 'Payouts & Royalties / Ledger', title: 'Payouts & Royalties', sub: 'Two-way ledger for outgoing partner commissions and incoming franchise royalties.', partner: 'Flagship Kemang (Franchise)' },
];
const modules = ['Dashboard', 'Partners', 'Products & Catalog', 'Commission & Rules', 'Orders & Inventory', 'Payouts & Royalties', 'Integrations', 'Settings'];
const bars = [
  ['Affiliates (184 active)', '$38,400', '72%'],
  ['Multi-Tier Agents (76 active)', '$49,200', '94%'],
  ['Stockist Resellers (58 active)', '$27,820', '55%'],
  ['Franchises (24 outlets)', '$33,500', '65%'],
];
const hid = (i: number) => (i === 0 ? undefined : true);
---

<div id="hero-devices" data-label-aktif={autoPreview} data-label-jeda={autoPreviewJeda}>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div role="group" aria-label={t('hero.scenes')} class="inline-flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg p-1">
      {
        adegan.map((label, i) => (
          <button
            type="button"
            data-scene-btn={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="px-2.5 py-1 rounded text-[11px] transition cursor-pointer aria-pressed:font-bold aria-pressed:bg-navy aria-pressed:text-white aria-[pressed=false]:font-semibold aria-[pressed=false]:text-slate-600 aria-[pressed=false]:hover:text-navy"
          >
            {label}
          </button>
        ))
      }
    </div>
    <button type="button" id="scene-pause" aria-pressed="false" class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-500 rounded cursor-pointer">
      <span class="relative flex h-2 w-2">
        <span data-ping class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span data-pause-label>{autoPreview}</span>
    </button>
  </div>

  <div class="relative pb-10 sm:pb-12 pr-2 sm:pr-6" role="img" aria-label={t('hero.devices')}>
    <div aria-hidden="true">
      <!-- Laptop -->
      <div class="animate-float-mac w-full max-w-[640px] mx-auto lg:mx-0">
        <div class="bg-ink rounded-t-2xl p-2 sm:p-2.5 border-2 border-slate-700 shadow-2xl relative">
          <div class="w-20 h-2.5 bg-ink rounded-b-md mx-auto -mt-2.5 mb-1.5 flex items-center justify-center relative z-20">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-700 ring-1 ring-slate-600"></span>
          </div>

          <div class="bg-slate-50 rounded-lg overflow-hidden border border-slate-800 flex min-h-[340px] sm:min-h-[375px] text-left select-none">
            <div class="w-32 sm:w-40 bg-navy text-white flex flex-col shrink-0 p-2.5 justify-between">
              <div>
                <div class="flex items-center gap-1.5 pb-2.5 border-b border-slate-800">
                  <Logo varian="gelap" class="w-5 h-5" />
                  <div>
                    <div class="text-[9px] font-extrabold tracking-tight leading-none">CHANNELORY</div>
                    <div class="text-[6.5px] text-sky-300 font-semibold tracking-wider uppercase mt-0.5">COMMAND CENTER</div>
                  </div>
                </div>
                <div class="my-2 px-2 py-1.5 rounded bg-navy-dark border border-slate-700/70">
