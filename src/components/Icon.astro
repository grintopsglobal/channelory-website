export type IconName = keyof typeof paths | 'wa';
interface Props {
  name: IconName;
  class?: string;
  stroke?: number | string;
  id?: string;
}
const { name, class: cls = 'w-5 h-5', stroke = 2, id } = Astro.props;
---

{
  name === 'wa' ? (
    <svg class:list={['fill-current', cls]} viewBox="0 0 24 24" aria-hidden="true" id={id}>
      <path d={WA} />
    </svg>
  ) : (
    <svg class={cls} fill="none" stroke="currentColor" stroke-width={stroke} viewBox="0 0 24 24" aria-hidden="true" id={id}>
      <path stroke-linecap="round" stroke-linejoin="round" d={paths[name]} />
    </svg>
  )
}
