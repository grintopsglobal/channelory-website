---
import { defaultLang, locales, type Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path tanpa prefix bahasa per locale, mis. { id: '/' } */
  alternates: Record<Lang, string>;
  siteName: string;
  ogTitle?: string;
  ogDescription?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, lang, alternates, siteName, ogTitle = title, ogDescription = description, keywords, image, type = 'website', jsonLd = [], noindex = false } = Astro.props;

const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(localizePath(lang, alternates[lang]));
const ogImage = image ? abs(withBase(image)) : '';
const ogLocale = { id: 'id_ID' } as const;
---

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={siteName} />
{
  noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <meta name="robots" content="index, follow" />
      <link rel="canonical" href={canonical} />
      {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localizePath(l, alternates[l]))} />)}
      <link rel="alternate" hreflang="x-default" href={abs(localizePath(defaultLang, alternates[defaultLang]))} />
    </>
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:locale" content={ogLocale[lang]} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
