---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDevices from './HeroDevices.astro';
import Pricing from './Pricing.astro';
import Icon, { type IconName } from './Icon.astro';
import { inlineMd, plainMd } from '../lib/md';
import { waLink } from '../lib/wa';
import { byLang, getPage, getSettings } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const [settings, home, ...koleksi] = await Promise.all([getSettings(lang), getPage(lang, 'home'), byLang('manfaat', lang), byLang('modul', lang), byLang('paket', lang), byLang('faq', lang)]);
const [manfaat, modul, paket, faq] = [koleksi[0].map((e) => e.data), koleksi[1].map((e) => e.data), koleksi[2].map((e) => e.data), koleksi[3].map((e) => e.data)];
const { hero, tentang, banner } = home;

// JSON-LD dari data CMS (A6): rentang harga dari semua mode semua paket, FAQPage dari koleksi faq.
const hargaSemua = paket.flatMap((p) => Object.values(p.mode).map((m) => m.hargaAngka));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Channelory',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: settings.seo.appDescription,
    slogan: settings.tagline,
    url: new URL('/id/', Astro.site).href,
    offers: { '@type': 'AggregateOffer', priceCurrency: 'IDR', lowPrice: String(Math.min(...hargaSemua)), highPrice: String(Math.max(...hargaSemua)), offerCount: String(hargaSemua.length) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pertanyaan, acceptedAnswer: { '@type': 'Answer', text: plainMd(f.jawaban) } })),
  },
];
const wa = (pesan: string) => waLink(settings.whatsapp, pesan, settings.pesanWa.pembuka);

// Potong judul H1 di sekitar teks sorot; kalau teks sorot tidak ditemukan, judul tampil polos.
const at = hero.judulSorot ? hero.judul.indexOf(hero.judulSorot) : -1;
const judul = at < 0 ? [hero.judul, '', ''] : [hero.judul.slice(0, at), hero.judulSorot, hero.judul.slice(at + hero.judulSorot.length)];
const eyebrow = 'text-sm font-semibold text-slate-600';
// sm:leading-* di bawah meniru Tailwind 3 di mockup: di sana sm:text-* ikut mengganti line-height dan mengalahkan leading-*.
const h2 = 'text-2xl sm:text-3xl font-extrabold text-navy tracking-tight';
---

<BaseLayout
  lang={lang}
  beranda
  title={settings.seo.title}
  description={settings.seo.description}
  ogTitle={settings.seo.ogTitle}
  ogDescription={settings.seo.ogDescription}
  keywords={settings.seo.keywords}
  alternates={{ id: '/' }}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-slate-bg border-b border-slate-200 py-14 sm:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <div class="lg:col-span-5 space-y-6">
          <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-navy tracking-tight leading-[1.15] sm:leading-10">
            {judul[0]}{judul[1] && <span class="text-sky-text">{judul[1]}</span>}{judul[2]}
          </h1>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed sm:leading-6" set:html={inlineMd(hero.paragraf)} />

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
            <a href={wa(settings.pesanWa.hero)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-cta hover:bg-cta-hover text-cta-ink text-sm font-bold transition shadow-xs">
              <span>{hero.ctaUtama}</span>
              <Icon name="panahPanjang" class="w-4 h-4" stroke="2.2" />
            </a>
            <a href="#harga" class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-navy text-sm font-bold transition">
              {hero.ctaHarga}
            </a>
          </div>

          <div class="pt-4 border-t border-slate-200">
            <div class="text-xs font-semibold text-slate-500 mb-2.5">{hero.integrasiJudul}</div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-bold text-navy">
              {hero.integrasi.map((i) => <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200">{i}</span>)}
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <HeroDevices lang={lang} adegan={hero.adegan} autoPreview={hero.autoPreview} autoPreviewJeda={hero.autoPreviewJeda} catatan={hero.ilustrasiCatatan} />
        </div>
      </div>
    </div>
  </section>

  <!-- Manfaat -->
  <section id="manfaat" class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class={eyebrow}>{home.manfaat.eyebrow}</span>
        <h2 class:list={[h2, 'mt-2']}>{home.manfaat.judul}</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed sm:leading-6">{home.manfaat.paragraf}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        {
          manfaat.map((m) => (
            <article class="p-6 rounded-xl bg-slate-bg border border-slate-200 flex flex-col justify-between">
              <div>
                <div class="w-11 h-11 rounded-lg bg-navy text-white flex items-center justify-center mb-5">
                  <Icon name={m.ikon as IconName} class="w-5 h-5 text-white" />
                </div>
                <div class="font-mono-num text-2xl font-extrabold text-navy">{m.angka}</div>
                <h3 class="text-base font-bold text-navy mt-2">{m.judul}</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed sm:leading-5">{m.deskripsi}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Fitur -->
  <section id="fitur" class="py-20 bg-slate-bg border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class={eyebrow}>{home.fitur.eyebrow}</span>
        <h2 class:list={[h2, 'mt-2']}>{home.fitur.judul}</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed sm:leading-6">{home.fitur.paragraf}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {
          modul.map((m) => (
            <div class="bg-white border border-slate-200 rounded-xl p-6">
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded bg-slate-100 text-slate-600 text-xs font-bold">{m.nomor}</span>
                <span class="text-xs font-semibold text-slate-500">{m.label}</span>
              </div>
              <h3 class="text-lg font-extrabold text-navy">{m.judul}</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed sm:leading-5" set:html={inlineMd(m.deskripsi)} />
              <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-700 font-medium">
                {m.poin.map((p) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400" />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Pricing lang={lang} teks={home.harga} paket={paket} whatsapp={settings.whatsapp} pembuka={settings.pesanWa.pembuka} />

  <!-- Tentang -->
  <section id="tentang" class="py-20 bg-slate-bg border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-5">
          <span class={eyebrow}>{tentang.eyebrow}</span>
          <h2 class={h2}>{tentang.judul}</h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed sm:leading-6" set:html={inlineMd(tentang.paragraf1)} />
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed sm:leading-6" set:html={inlineMd(tentang.paragraf2)} />
        </div>
        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            tentang.pilar.map((p) => (
              <div class="bg-white border border-slate-200 rounded-xl p-6">
                <div class="text-sm font-semibold text-slate-500">{p.label}</div>
                <div class="text-lg font-extrabold text-navy mt-2">{p.judul}</div>
                <p class="text-xs text-slate-600 mt-2 leading-relaxed">{p.deskripsi}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class={eyebrow}>{home.faq.eyebrow}</span>
        <h2 class:list={[h2, 'mt-2']}>{home.faq.judul}</h2>
      </div>
      <div class="mt-10 space-y-3">
        {
          faq.map((f, i) => (
            <div class="border border-slate-200 rounded-xl overflow-hidden">
              <h3>
                <button
                  type="button"
                  data-faq
                  aria-expanded={f.terbuka ? 'true' : 'false'}
                  aria-controls={`faq-ans-${i}`}
                  class="group w-full px-6 py-4 bg-slate-50 hover:bg-slate-100 focus-visible:-outline-offset-2 focus-visible:rounded-xl flex items-center justify-between text-left gap-4 cursor-pointer"
                >
                  <span class="text-sm font-bold text-navy">{f.pertanyaan}</span>
                  <Icon name="chevron" class="w-5 h-5 text-slate-500 shrink-0 transition-transform duration-200 group-aria-expanded:rotate-180" />
                </button>
              </h3>
              <div id={`faq-ans-${i}`} hidden={!f.terbuka} class="px-6 py-4 bg-white text-xs sm:text-sm text-slate-600 leading-relaxed sm:leading-5 border-t border-slate-100" set:html={inlineMd(f.jawaban)} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Banner CTA -->
  <section class="on-dark py-16 bg-navy text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <p class="text-base font-semibold text-slate-300">{banner.eyebrow}</p>
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">{banner.judul}</h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed sm:leading-6">{banner.paragraf}</p>
      <div class="pt-2">
        <a href={wa(settings.pesanWa.banner)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 rounded-xl bg-cta hover:bg-cta-hover text-cta-ink text-base font-extrabold transition shadow-lg">
          {banner.cta}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = !open;
    }),
  );
</script>
